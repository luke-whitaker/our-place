# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database
/data/*.db
/data/*.db-wal
/data/*.db-shm

# uploaded media
/public/uploads/

/src/generated/prisma

# private audit/security notes — kept local, never committed (public repo).
# Drop any audit docs in here; the whole directory stays off the remote.
/audits/

# local-only session handoff notes for the next session — never committed
/LAST-SESSION.md

# internal roadmap / decisions-to-revisit — never committed (public repo)
/ROADMAP.md

# local UI/aesthetic inspiration screenshots — never committed
# (public repo; contains copyrighted game art / reference material)
/social media UI inspo/
/world UI inspo/

# local design-direction mockups (exploratory, pre-decision) — never committed
/mockups/

# purchased/licensed art source — NEVER committed (public repo = redistribution,
# which the licenses forbid). See CREDITS.md. Runtime sprites are served out of
# git (R2 / a gitignored dev copy under public/world/characters/).
/assets/Evergrow_Forest_v0.5/
/assets/SpriteSheet*.png
/assets/world/*.png
/public/world/characters/
/public/world/tiles/
/public/world/objects/

# Claude Code agent worktrees (ephemeral; created inside the repo by the Agent tool)
/.claude/worktrees/
