# Our Place — Environment Variables
# Copy this file to .env.local and fill in real values.

# A strong random string used to sign JWTs (required in production)
JWT_SECRET=change-me-to-a-random-secret

# PostgreSQL connection string
# Local: postgresql://user:password@localhost:5432/ourplace
# Railway: provided automatically as DATABASE_URL
DATABASE_URL=postgresql://user:password@localhost:5432/ourplace

# Transactional email (Resend) — required in production for password reset.
# Without RESEND_API_KEY, reset codes are logged to the server console (dev only).
RESEND_API_KEY=
EMAIL_FROM=Our Place <noreply@ourplaceonline.com>

# Number of trusted reverse proxies in front of the app (Railway's edge = 1).
# Picks the real client IP from X-Forwarded-For for rate limiting; raise only if
# you add another trusted proxy/CDN in front.
TRUSTED_PROXY_HOPS=1
