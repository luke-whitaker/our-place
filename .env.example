# Our Place — Environment Variables
# Copy this file to .env.local and fill in real values.

# A strong random string used to sign JWTs (required in production)
JWT_SECRET=change-me-to-a-random-secret

# PostgreSQL connection string.
# Local dev: run `docker compose up -d` to start the bundled Postgres, which
#   matches the URL below. Prisma CLI (migrate/seed/studio) reads DATABASE_URL
#   from .env; the Next.js dev server reads .env.local — so to keep dev OFF prod,
#   put the local URL in BOTH .env and .env.development.local (the latter
#   overrides .env.local). See docker-compose.yml.
# Railway (prod): set DATABASE_URL in the Railway dashboard, never in these files.
DATABASE_URL=postgresql://ourplace:ourplace@localhost:5432/ourplace

# Transactional email (Resend) — required in production for password reset.
# Without RESEND_API_KEY, reset codes are logged to the server console (dev only).
RESEND_API_KEY=
EMAIL_FROM=Our Place <noreply@ourplaceonline.com>

# Number of trusted reverse proxies in front of the app (Railway's edge = 1).
# Picks the real client IP from X-Forwarded-For for rate limiting; raise only if
# you add another trusted proxy/CDN in front.
TRUSTED_PROXY_HOPS=1

# Cloudflare R2 object storage — media uploads and world art.
# This bucket is served PUBLICLY. Never put database dumps or anything
# private in it.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Database backups (`npm run db:backup`, and the nightly GitHub Action).
# Must be a SEPARATE, PRIVATE bucket: a dump carries real names, emails,
# phone numbers, and password hashes. The script refuses to run if this
# matches R2_BUCKET. The key pair is optional — it falls back to the R2_*
# credentials above — but a token scoped to only this bucket is better.
R2_BACKUP_BUCKET=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=

# Base URL for world art sprites. Empty in dev → served from public/world/.
# In prod, set to R2_PUBLIC_BASE_URL (upload the art with `npm run world:upload`).
# The bucket must allow CORS GET from the app origin: object sprites are
# alpha-scanned on a canvas, which taints (and fails) without CORS.
NEXT_PUBLIC_WORLD_ASSET_BASE=
