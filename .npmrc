# Supply-chain hardening (JUNE-AUDIT D2): never auto-run dependency install scripts.
# This is the project-wide default for every npm command, including CI.
# Prisma's client is NOT auto-generated as a result — run `npm run db:generate`
# (or `npm run build`, which generates it explicitly) after a fresh `npm install`.
ignore-scripts=true

# Match the deployed runtime and fail loudly on version drift (JUNE-AUDIT D7).
engine-strict=true
