generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid())
  username           String    @unique
  displayName        String    @map("display_name")
  email              String    @unique
  phone              String?   @unique
  passwordHash       String    @map("password_hash")
  bio                String    @default("")
  avatarColor        String    @default("#6366f1") @map("avatar_color")
  avatar             Json?
  theme              String    @default("auto")
  // The member's floating My Place island: its biome (a terrain-tint preset)
  // and who may visit it ("anyone" | "friends" | "nobody"). Friends-only by
  // default, matching My Place posts in the forum.
  biome              String    @default("forest")
  islandVisibility   String    @default("friends") @map("island_visibility")
  // The island mailbox's paint color, chosen independently of the biome so a
  // member can tell their mailbox apart after a biome change.
  mailboxColor       String    @default("slate") @map("mailbox_color")
  role               String    @default("user")
  isVerified         Boolean   @default(true) @map("is_verified")
  resetCode          String?   @map("reset_code")
  resetCodeExpiresAt DateTime? @map("reset_code_expires_at")
  passwordChangedAt  DateTime? @map("password_changed_at")
  invitedById        String?   @map("invited_by_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  // Web of trust: who vouched for this account. Null only for trust roots
  // (the founding admin, the seed system user) — every invited member has one.
  inviter  User?  @relation("WebOfTrust", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees User[] @relation("WebOfTrust")

  createdCommunities  Community[]       @relation("CommunityCreator")
  memberships         CommunityMember[]
  posts               Post[]            @relation("PostAuthor")
  comments            Comment[]
  reactions           Reaction[]
  createdEvents       Event[]           @relation("EventCreator")
  eventRsvps          EventRsvp[]
  sentFriendships     Friendship[]      @relation("FriendshipSender")
  receivedFriendships Friendship[]      @relation("FriendshipReceiver")
  items               Item[]            @relation("ItemOwner")
  sentItems           Item[]            @relation("ItemSender")
  notebookPages       NotebookPage[]
  npcGifts            NpcGift[]

  @@index([email])
  @@index([username])
  @@index([invitedById])
  @@map("users")
}

model Community {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String
  category    String
  icon        String   @default("\uD83C\uDF10")
  bannerColor String   @default("#6366f1") @map("banner_color")
  guidelines  String   @default("")
  creatorId   String   @map("creator_id")
  isOfficial  Boolean  @default(false) @map("is_official")
  memberCount Int      @default(1) @map("member_count")
  createdAt   DateTime @default(now()) @map("created_at")

  creator User              @relation("CommunityCreator", fields: [creatorId], references: [id])
  members CommunityMember[]
  posts   Post[]
  events  Event[]

  @@map("communities")
}

model CommunityMember {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  communityId String   @map("community_id")
  role        String   @default("member")
  joinedAt    DateTime @default(now()) @map("joined_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([userId])
  @@index([communityId])
  @@map("community_members")
}

model Post {
  id              String   @id @default(uuid())
  authorId        String   @map("author_id")
  communityId     String?  @map("community_id")
  postType        String   @default("text") @map("post_type")
  postedToProfile Boolean  @default(false) @map("posted_to_profile")
  title           String   @default("")
  content         String   @default("")
  commentCount    Int      @default(0) @map("comment_count")
  // reaction_count counts likes; dislikes are counted apart so they never
  // inflate a post's likes.
  reactionCount   Int      @default(0) @map("reaction_count")
  dislikeCount    Int      @default(0) @map("dislike_count")
  // Interaction controls the author picks at compose time. Reactions and
  // comments are on unless switched off; dislikes are off unless opted in.
  allowReactions  Boolean  @default(true) @map("allow_reactions")
  allowComments   Boolean  @default(true) @map("allow_comments")
  allowDislikes   Boolean  @default(false) @map("allow_dislikes")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  author    User        @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  community Community?  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  media     PostMedia[]
  comments  Comment[]
  reactions Reaction[]

  @@index([communityId])
  @@index([authorId])
  @@index([createdAt(sort: Desc)])
  @@index([communityId, createdAt(sort: Desc)])
  @@index([authorId, postedToProfile])
  @@map("posts")
}

model PostMedia {
  id          String   @id @default(uuid())
  postId      String   @map("post_id")
  mediaType   String   @map("media_type")
  mediaSource String   @default("upload") @map("media_source")
  url         String
  filename    String?
  fileSize    Int?     @map("file_size")
  width       Int?
  height      Int?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_media")
}

model Comment {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  authorId  String   @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
  @@map("comments")
}

model Reaction {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  type      String   @default("like")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId, postId])
  @@map("reactions")
}

model Friendship {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  friendId  String   @map("friend_id")
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")

  user   User @relation("FriendshipSender", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendshipReceiver", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
  @@map("friendships")
}

model Event {
  id           String    @id @default(uuid())
  title        String
  description  String
  location     String    @default("")
  eventDate    DateTime  @map("event_date")
  eventEndDate DateTime? @map("event_end_date")
  communityId  String?   @map("community_id")
  creatorId    String    @map("creator_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  community Community?  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  creator   User        @relation("EventCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  rsvps     EventRsvp[]

  @@index([eventDate])
  @@index([communityId])
  @@index([creatorId])
  @@map("events")
}

model EventRsvp {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  status    String   @default("going")
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_rsvps")
}

// Every item a member owns, in one of their locations: pockets (10 slots) or
// their mailbox (20 slots); the house desk joins as another location later.
// `kind` and `location` are catalog keys (ItemKind and ItemLocation in
// src/lib/items.ts) validated in code, not the schema, matching how postType
// and reaction type work elsewhere.
model Item {
  id        String    @id @default(uuid())
  ownerId   String    @map("owner_id")
  kind      String
  location  String    @default("pocket")
  slot      Int?
  body      String?
  fromId    String?   @map("from_id")
  placedAt  DateTime? @map("placed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  owner User  @relation("ItemOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  from  User? @relation("ItemSender", fields: [fromId], references: [id], onDelete: SetNull)

  // Stops two items sharing a slot within the same location, even under
  // concurrent requests. Together with each location's slot bound
  // (LOCATION_SLOTS in src/lib/items.ts), this caps that location's capacity
  // by construction.
  @@unique([ownerId, location, slot])
  @@index([ownerId])
  @@index([fromId])
  @@map("items")
}

// A member's private Notebook drafts. @@unique([ownerId, page]) bounds a
// member to 10 drafts by construction — the tenth page is 9.
model NotebookPage {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  page      Int
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, page])
  @@map("notebook_pages")
}

// Tracks which one-time NPC gifts (Gnomie's Notebook, and future gifts) a
// member has already received, so a gift is never given twice.
model NpcGift {
  userId  String   @map("user_id")
  giftId  String   @map("gift_id")
  givenAt DateTime @default(now()) @map("given_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Makes each gift once-only per member.
  @@id([userId, giftId])
  @@map("npc_gifts")
}
