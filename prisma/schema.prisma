generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid())
  username           String    @unique
  displayName        String    @map("display_name")
  email              String    @unique
  phone              String?   @unique
  passwordHash       String    @map("password_hash")
  bio                String    @default("")
  avatarColor        String    @default("#6366f1") @map("avatar_color")
  avatar             Json?
  theme              String    @default("auto")
  // The member's floating My Place island: its biome (a terrain-tint preset)
  // and who may visit it ("anyone" | "friends" | "nobody"). Friends-only by
  // default, matching My Place posts in the forum.
  biome              String    @default("forest")
  islandVisibility   String    @default("friends") @map("island_visibility")
  // The island mailbox's paint color, chosen independently of the biome so a
  // member can tell their mailbox apart after a biome change.
  mailboxColor       String    @default("slate") @map("mailbox_color")
  // Ghost Mode, chosen at the house armoire: while true, nobody else in the
  // world sees this member (the presence hub never sends their position). It
  // stays on across visits until the member changes it at the armoire.
  ghost              Boolean   @default(false)
  // Leaves this member out of the admin metrics: no activity_days rows are
  // written for them, and turning it on deletes the ones already there.
  excludeFromMetrics Boolean   @default(false) @map("exclude_from_metrics")
  role               String    @default("user")
  isVerified         Boolean   @default(true) @map("is_verified")
  // An HMAC of the emailed code, never the code itself, and the wrong guesses
  // against it: the fifth wipes the code, so a new one has to be requested.
  resetCodeHash      String?   @map("reset_code_hash")
  resetCodeAttempts  Int       @default(0) @map("reset_code_attempts")
  resetCodeExpiresAt DateTime? @map("reset_code_expires_at")
  passwordChangedAt  DateTime? @map("password_changed_at")
  invitedById        String?   @map("invited_by_id")
  // Set when the member deleted their account. The row stays as a nameless
  // tombstone ("A former member") so posts they chose to leave up, letters
  // they sent, and the members they vouched for still point somewhere; every
  // personal field is wiped at the same moment (src/lib/account-deletion.ts).
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  // Web of trust: who vouched for this account. Null only for trust roots
  // (the founding admin, the seed system user) — every invited member has one.
  inviter  User?  @relation("WebOfTrust", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees User[] @relation("WebOfTrust")

  createdCommunities  Community[]       @relation("CommunityCreator")
  memberships         CommunityMember[]
  posts               Post[]            @relation("PostAuthor")
  comments            Comment[]
  reactions           Reaction[]
  createdEvents       Event[]           @relation("EventCreator")
  eventRsvps          EventRsvp[]
  sentFriendships     Friendship[]      @relation("FriendshipSender")
  receivedFriendships Friendship[]      @relation("FriendshipReceiver")
  items               Item[]            @relation("ItemOwner")
  sentItems           Item[]            @relation("ItemSender")
  notebookPages       NotebookPage[]
  npcGifts            NpcGift[]
  outfits             Outfit[]
  notifications       Notification[]    @relation("NotificationRecipient")
  causedNotifications Notification[]    @relation("NotificationActor")
  activityDays        ActivityDay[]
  hostedGatherings    Gathering[]       @relation("GatheringHost")
  gatheringInvites    GatheringInvite[]
  worldDiscoveries    WorldDiscovery[]
  worldPlants         WorldPlant[]

  @@index([email])
  @@index([username])
  @@index([invitedById])
  @@map("users")
}

model Community {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String
  category    String
  icon        String   @default("\uD83C\uDF10")
  bannerColor String   @default("#6366f1") @map("banner_color")
  guidelines  String   @default("")
  creatorId   String   @map("creator_id")
  isOfficial  Boolean  @default(false) @map("is_official")
  memberCount Int      @default(1) @map("member_count")
  createdAt   DateTime @default(now()) @map("created_at")

  creator    User              @relation("CommunityCreator", fields: [creatorId], references: [id])
  members    CommunityMember[]
  posts      Post[]
  events     Event[]
  gatherings Gathering[]

  @@map("communities")
}

model CommunityMember {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  communityId String   @map("community_id")
  role        String   @default("member")
  joinedAt    DateTime @default(now()) @map("joined_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([userId])
  @@index([communityId])
  @@map("community_members")
}

model Post {
  id              String   @id @default(uuid())
  authorId        String   @map("author_id")
  communityId     String?  @map("community_id")
  postType        String   @default("text") @map("post_type")
  postedToProfile Boolean  @default(false) @map("posted_to_profile")
  title           String   @default("")
  content         String   @default("")
  commentCount    Int      @default(0) @map("comment_count")
  // reaction_count counts likes; dislikes are counted apart so they never
  // inflate a post's likes.
  reactionCount   Int      @default(0) @map("reaction_count")
  dislikeCount    Int      @default(0) @map("dislike_count")
  // Interaction controls the author picks at compose time. Reactions and
  // comments are on unless switched off; dislikes are off unless opted in.
  allowReactions  Boolean  @default(true) @map("allow_reactions")
  allowComments   Boolean  @default(true) @map("allow_comments")
  allowDislikes   Boolean  @default(false) @map("allow_dislikes")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  author    User        @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  community Community?  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  media     PostMedia[]
  comments  Comment[]
  reactions Reaction[]

  notifications Notification[]

  @@index([communityId])
  @@index([authorId])
  @@index([createdAt(sort: Desc)])
  @@index([communityId, createdAt(sort: Desc)])
  @@index([authorId, postedToProfile])
  @@map("posts")
}

model PostMedia {
  id          String   @id @default(uuid())
  postId      String   @map("post_id")
  mediaType   String   @map("media_type")
  mediaSource String   @default("upload") @map("media_source")
  url         String
  filename    String?
  fileSize    Int?     @map("file_size")
  width       Int?
  height      Int?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_media")
}

model Comment {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  authorId  String   @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  notification Notification?

  @@index([postId])
  @@index([authorId])
  @@map("comments")
}

model Reaction {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  type      String   @default("like")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  notification Notification?

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId, postId])
  @@map("reactions")
}

model Friendship {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  friendId  String   @map("friend_id")
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")

  user   User @relation("FriendshipSender", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendshipReceiver", fields: [friendId], references: [id], onDelete: Cascade)

  notifications Notification[]

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
  @@map("friendships")
}

model Event {
  id           String    @id @default(uuid())
  title        String
  description  String
  location     String    @default("")
  eventDate    DateTime  @map("event_date")
  eventEndDate DateTime? @map("event_end_date")
  communityId  String?   @map("community_id")
  creatorId    String    @map("creator_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  community Community?  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  creator   User        @relation("EventCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  rsvps     EventRsvp[]

  @@index([eventDate])
  @@index([communityId])
  @@index([creatorId])
  @@map("events")
}

model EventRsvp {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  status    String   @default("going")
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_rsvps")
}

// Every item a member owns, in one of their locations: pockets (10 slots) or
// their mailbox (20 slots); the house desk joins as another location later.
// `kind` and `location` are catalog keys (ItemKind and ItemLocation in
// src/lib/items.ts) validated in code, not the schema, matching how postType
// and reaction type work elsewhere.
model Item {
  id          String    @id @default(uuid())
  ownerId     String    @map("owner_id")
  kind        String
  location    String    @default("pocket")
  slot        Int?
  body        String?
  fromId      String?   @map("from_id")
  placedAt    DateTime? @map("placed_at")
  // An invitation letter's gathering, so the letter can offer Accept and
  // Decline. The body never carries the address: letters can be handed on.
  gatheringId String?   @map("gathering_id")
  // A flower's color (FLOWER_COLORS in src/lib/plants.ts); null for every
  // other kind. A column rather than the body, so a note can never pass as
  // a red flower.
  color       String?
  // How many share this slot. Only stackable kinds (ITEM_CATALOG) go above
  // 1, never past MAX_STACK; a check constraint keeps it between 1 and 99.
  quantity    Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")

  owner     User       @relation("ItemOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  from      User?      @relation("ItemSender", fields: [fromId], references: [id], onDelete: SetNull)
  gathering Gathering? @relation(fields: [gatheringId], references: [id], onDelete: SetNull)

  // Stops two items sharing a slot within the same location, even under
  // concurrent requests. Together with each location's slot bound
  // (LOCATION_SLOTS in src/lib/items.ts), this caps that location's capacity
  // by construction.
  @@unique([ownerId, location, slot])
  @@index([ownerId])
  @@index([fromId])
  @@index([gatheringId])
  @@map("items")
}

// A member's private Notebook drafts. @@unique([ownerId, page]) bounds a
// member to 10 drafts by construction — the tenth page is 9.
model NotebookPage {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  page      Int
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, page])
  @@map("notebook_pages")
}

// A saved outfit in a member's house armoire: a look of hair (style and color)
// and shirt, pants, and shoes colors, never skin. @@unique([ownerId, slot]) with slots 0 to 4 caps a member
// at five by construction, the same way items cap each location.
model Outfit {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  slot      Int
  name      String   @default("")
  hairStyle String   @map("hair_style")
  hairColor String   @map("hair_color")
  shirt     String
  pants     String
  shoes     String
  createdAt DateTime @default(now()) @map("created_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, slot])
  @@map("outfits")
}

// Tracks which one-time NPC gifts (Gnomie's Notebook, and future gifts) a
// member has already received, so a gift is never given twice.
model NpcGift {
  userId  String   @map("user_id")
  giftId  String   @map("gift_id")
  givenAt DateTime @default(now()) @map("given_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Makes each gift once-only per member.
  @@id([userId, giftId])
  @@map("npc_gifts")
}

// One thing that happened to a member: a friend request, a request accepted,
// a reaction, a comment, a gathering invitation, or a gathering cancelled. Each row points at what caused it and cascades
// with it, so a canceled request, a removed reaction, or a deleted comment
// takes its notification along. Reactions are grouped per post when read.
model Notification {
  id           String    @id @default(uuid())
  recipientId  String    @map("recipient_id")
  actorId      String    @map("actor_id")
  // "friend_request" | "friend_accepted" | "reaction" | "comment" |
  // "gathering_invite" | "gathering_cancelled" | "gathering_unplanted"
  kind         String
  friendshipId String?   @map("friendship_id")
  gatheringId  String?   @map("gathering_id")
  postId       String?   @map("post_id")
  reactionId   String?   @unique @map("reaction_id")
  commentId    String?   @unique @map("comment_id")
  readAt       DateTime? @map("read_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  recipient  User        @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor      User        @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  friendship Friendship? @relation(fields: [friendshipId], references: [id], onDelete: Cascade)
  post       Post?       @relation(fields: [postId], references: [id], onDelete: Cascade)
  reaction   Reaction?   @relation(fields: [reactionId], references: [id], onDelete: Cascade)
  comment    Comment?    @relation(fields: [commentId], references: [id], onDelete: Cascade)
  gathering  Gathering?  @relation(fields: [gatheringId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([friendshipId])
  @@index([gatheringId])
  @@index([postId])
  @@map("notifications")
}

// One row per member per day they signed in, for the admin metrics dashboard.
// `day` is a calendar date in America/Chicago (METRICS_TIME_ZONE in
// src/lib/activity.ts), and `worldSeconds` adds up the world visits that ended
// that day. Nothing about what a member read or where they walked is kept.
// Rows older than ACTIVITY_RETENTION_DAYS are pruned, so the table is bounded.
model ActivityDay {
  userId       String   @map("user_id")
  day          DateTime @db.Date
  worldSeconds Int      @default(0) @map("world_seconds")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day])
  @@map("activity_days")
}

// A gathering a member hosts: in person (with an address) or, from v0.20.0,
// in the world. Tied to a community, it invites that whole community and shows
// on its calendar. Cancelling keeps the row (status "cancelled") so letters
// and notifications about it can still say so.
model Gathering {
  id            String    @id @default(uuid())
  hostId        String    @map("host_id")
  communityId   String?   @map("community_id")
  // "in_person" | "world"
  kind          String
  title         String
  description   String    @default("")
  startsAt      DateTime  @map("starts_at")
  endsAt        DateTime  @map("ends_at")
  // Shown only to people who can see the gathering; never in a letter. Empty
  // for a gathering in the world.
  address       String    @default("")
  // "scheduled" | "cancelled"
  status        String    @default("scheduled")
  cancelledAt   DateTime? @map("cancelled_at")
  // Where a world gathering's Event Mushroom stands: a world id ("capital",
  // "island:<host id>", or "<slug>-inside") and a tile. All null until the
  // host plants it, and null again while it's picked up.
  mushroomWorld String?   @map("mushroom_world")
  mushroomCol   Int?      @map("mushroom_col")
  mushroomRow   Int?      @map("mushroom_row")
  plantedAt     DateTime? @map("planted_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  host          User              @relation("GatheringHost", fields: [hostId], references: [id], onDelete: Cascade)
  community     Community?        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  invites       GatheringInvite[]
  letters       Item[]
  notifications Notification[]

  @@index([communityId, startsAt])
  @@index([hostId])
  @@index([startsAt])
  @@index([mushroomWorld])
  @@map("gatherings")
}

// One member's invitation to a gathering and their answer. The host has an
// "accepted" row from the start. A member who joins a community after its
// gathering was created gets a row when they first answer.
model GatheringInvite {
  id          String    @id @default(uuid())
  gatheringId String    @map("gathering_id")
  userId      String    @map("user_id")
  // "pending" | "accepted" | "declined"
  status      String    @default("pending")
  respondedAt DateTime? @map("responded_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  gathering Gathering @relation(fields: [gatheringId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gatheringId, userId])
  @@index([userId, status])
  @@map("gathering_invites")
}

// What one member has found in a world with a map: the areas they've walked
// (1 bit per 8x8-tile chunk, row-major) and the Mycelium shrines they've
// discovered. Kept per account, so a new phone remembers both. Writes only
// ever add (bitwise OR, set union), so they're idempotent and order-free.
model WorldDiscovery {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  worldId   String   @map("world_id")
  visited   Bytes
  shrines   String[] @default([])
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, worldId])
  @@map("world_discoveries")
}

/// A seed or flower placed in a world by a member: on their own island, or in
/// the shared Capital (at most 10 there). A seed blooms at `blooms_at`, decided
/// at planting; bloom is read from the clock, never written by a job. `color`
/// is chosen at planting too but never sent to anyone before the bloom.
/// `yields_seed` is true only for a plant grown from a seed, so plucking it
/// the first time gives a seed back; a flower placed from pockets never does.
model WorldPlant {
  id         String    @id @default(uuid())
  ownerId    String    @map("owner_id")
  worldId    String    @map("world_id")
  col        Int
  row        Int
  color      String
  plantedAt  DateTime  @default(now()) @map("planted_at")
  // Null for a flower placed from pockets: it's already in bloom.
  bloomsAt   DateTime? @map("blooms_at")
  yieldsSeed Boolean   @default(false) @map("yields_seed")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // One thing per tile, even under concurrent requests.
  @@unique([worldId, col, row])
  @@index([ownerId, worldId])
  @@map("world_plants")
}
